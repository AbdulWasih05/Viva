# Copy to .env and fill in. Never commit real keys (the repo and its Entire checkpoints are public).

# Which model the app talks to. "hosted" is the default for development and the demo;
# "ollama" is for offline / private use on your own machine.
LLM_PROVIDER=hosted

# Hosted Gemma. Default: Google AI Studio (key from aistudio.google.com), reached through
# Google's native API by Mastra's model router as "google/<HOSTED_MODEL>".
HOSTED_API_KEY=
HOSTED_MODEL=gemma-4-26b-a4b-it
# Leave empty for Google. Set it only to use an OpenAI-compatible fallback such as OpenRouter
# (https://openrouter.ai/api/v1 with HOSTED_MODEL=google/gemma-4-26b-a4b-it:free).
HOSTED_BASE_URL=

# Local Gemma through Ollama's OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b

# Optional: raises the GitHub API rate limit when reading repos.
GITHUB_TOKEN=

# Tracing (optional). Without a DSN nothing is sent to Sentry.
SENTRY_DSN=
# true = also print each AI span to the server log (useful to see what Sentry receives).
SENTRY_DEBUG_SPANS=

# true = local folders + memory are allowed. Must be false on Render.
LOCAL_MODE=true
MEMORY_DB_PATH=.viva/memory.db
